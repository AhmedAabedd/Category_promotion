<odoo>

    <record id="view_promotion_product_tree" model="ir.ui.view">
        <field name="name">promotion.product.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="default_code"/>
                <field name="discount_percentage"/>
            </list>
        </field>
    </record>

    <record id="view_promotion_product_form" model="ir.ui.view">
        <field name="name">promotion.product.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="name">Promotion Name</label>
                            <field name="name" string="Promotion Name" placeholder="e.g. 20% prmotion"/>
                        </h1>
                    </div>
                    <group>
                        <field name="default_code" placeholder="e.g. PROMO"/>
                        <field name="discount_percentage"/>
                        <field name="min_quantity"/>
                    </group>
                </sheet>
            </form>
        </field>

    </record>



    <record id="action_promotion_product" model="ir.actions.act_window">
        <field name="name">Our Promotions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_promotion_product_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_promotion_product_form')})
        ]"/>
        <field name="domain">[('is_promotion', '=', True)]</field>
        <field name="context">{'default_is_promotion': True,
                               'default_detailed_type': 'service',
                               'default_purshase_ok': False,
                               'default_taxes_id': False,
                               'supplier_taxes_id': False
                              }
        </field>
    </record>

</odoo>