<odoo>

    <record id="view_inherit_sale_order_promotion_form" model="ir.ui.view">
        <field name="name">sale.order.inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <button string="Promotion" type="object" name="action_add_promotion" attrs="{'invisible': [('can_apply_promotion', '=', False)]}"/>
                <field name="can_apply_promotion" invisible="1"/>
            </field>
            <field name="fiscal_position_id" position="after">
                <group>
                    <field name="promotion_id"/>
                </group>
            </field>
        </field>
    </record>

</odoo>