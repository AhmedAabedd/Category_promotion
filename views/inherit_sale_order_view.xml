<odoo>

    <record id="view_inherit_sale_order_promotion_form" model="ir.ui.view">
        <field name="name">sale.order.inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <button string="Promotion" type="object" name="action_add_promotion"/>
                <field name="can_apply_promotion" invisible="1"/>
            </field>
            <field name="fiscal_position_id" position="after">
                <field name="promotion_id"/>
            </field>

            <!--<xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="is_promotion_line" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-success">is_promotion_line</attribute>
            </xpath>-->
        </field>
    </record>

</odoo>