<odoo>

    <record id="view_promotion_select_form" model="ir.ui.view">
        <field name="name">promotion.select.form</field>
        <field name="model">promotion.select</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="promotion_id"/>
                </group>
            </form>
        </field>
    </record>


    <record id="action_select_promotion" model="ir.actions.act_window">
        <field name="name">Select a Promotion</field>
        <field name="res_model">promotion.select</field>
    </record>

</odoo>